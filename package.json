{
  "name": "ascend-glyph-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "deploy": "wrangler deploy",
    "check": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "corpus:build": "tsx scripts/build-research-corpus.ts",
    "corpus:import": "tsx scripts/import-research-corpus.ts",
    "tesseract:worker": "tsx scripts/run-tesseract-worker.ts",
    "verify:tesseract-worker": "npm run typecheck --workspace=@ascend/tesseract-engine && npm run build --workspace=@ascend/tesseract-engine && npm test --workspace=@ascend/tesseract-engine && npm run pilot --workspace=@ascend/tesseract-engine && npm run typecheck --workspace=@ascend/stitch-engine && npm test --workspace=@ascend/stitch-engine",
    "render:build:tesseract": "npm install --no-audit --no-fund && npm run verify:tesseract-worker",
    "benchmark:motif": "tsx scripts/benchmark-motif-reconstruction.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "wrangler": "^4.46.0"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "sharp": "^0.35.4"
  }
}

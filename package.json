{
  "name": "ascend-glyph-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "deploy": "wrangler deploy",
    "check": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "corpus:build": "tsx scripts/build-research-corpus.ts",
    "corpus:import": "tsx scripts/import-research-corpus.ts",
    "tesseract:worker": "tsx scripts/run-tesseract-worker.ts"
  },
  "devDependencies": {
    "wrangler": "^4.46.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "sharp": "^0.35.4"
  }
}

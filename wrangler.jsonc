{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ascend-glyph-studio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    {
      "binding": "GLYPH_ASSETS",
      "bucket_name": "ascend-glyph-assets"
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "GLYPH_ASSETS",
        "bucket_name": "ascend-glyph-assets"
      }
    ]
  },
  "build": {
    "command": "npm run build --workspace=@ascend/glyph-studio-web"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "STUDIO_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/assets/*"
    ]
  }
}

